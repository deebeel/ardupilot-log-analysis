# На VPS: /etc/wireguard/wg0.conf, права 600. Ключі згенерувати на самому VPS
# (`wg genkey | tee server.key | wg pubkey > server.pub`) — приватний ключ ніколи не
# передається мережею й не комітиться. Публічний ключ клієнта (SITL-хоста) підставляється
# сюди після його генерації там.
[Interface]
Address = 10.10.0.1/24
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>

[Peer]
PublicKey = <CLIENT_PUBLIC_KEY>
AllowedIPs = 10.10.0.2/32
