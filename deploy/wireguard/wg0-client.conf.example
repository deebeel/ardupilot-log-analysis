# На SITL-хості: /etc/wireguard/wg0.conf, права 600. `AllowedIPs = 10.10.0.0/24`, НЕ
# `0.0.0.0/0` — тунелюємо лише службову мережу до VPS, не весь трафік хоста.
[Interface]
Address = 10.10.0.2/24
PrivateKey = <CLIENT_PRIVATE_KEY>

[Peer]
PublicKey = <SERVER_PUBLIC_KEY>
Endpoint = <VPS_PUBLIC_IP>:51820
AllowedIPs = 10.10.0.0/24
PersistentKeepalive = 25
