# Скопіювати в .env (не комітиться) і підставити реальні значення.

# Тег образів parser/web — заповнюється build/save-кроком (docker save | gzip).
TAG=local

# Домен, який видає замовник разом із SSL-сертифікатом. Локально/без домену — localhost,
# Caddy тоді сам видає self-signed сертифікат.
DOMAIN=localhost

# Абсолютний шлях до bind-mounted теки результатів (inbox/ + results/), спільної для
# parser і web. Локально — репозиторний data/ (вже в .gitignore); на VPS — /srv/app/data.
DATA_DIR=../../data
