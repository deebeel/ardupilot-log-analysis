---
import Base from '../layouts/Base.astro';
import FlightListPoller from '../components/FlightListPoller.astro';
import { listFlights } from '../lib/results.ts';

// Страховка на випадок зміни `output` у конфізі.
export const prerender = false;

// readdir — САМЕ ТУТ, у тілі сторінки: на верхньому рівні модуля він виконався б
// один раз при старті процесу і заморозив би список польотів.
const flights = await listFlights();
---

<Base title="Польоти — якість пілотування">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Польоти</h1>
    <span class="text-xs text-slate-500" data-testid="poll-indicator">оновлюється щосекунди</span>
  </div>

  <FlightListPoller flights={flights} />
</Base>

<script>
  // Плейн-`<script>` у шаблоні Astro відправляється тільки клієнту й ніколи не
  // виконується під час SSR (на відміну від імпорту у frontmatter, де `htmx.org`
  // одразу падає на серверних глобалах типу `location`).
  import 'htmx.org';
</script>
