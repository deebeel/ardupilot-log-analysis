---
import Base from '../../layouts/Base.astro';
import FlightError from './_FlightError.astro';
import FlightSuccess from './_FlightSuccess.astro';
import { readFlight } from '../../lib/results.ts';

export const prerender = false;

// `id` береться з Astro.params у рантаймі; getStaticPaths свідомо не використовується.
// Валідація id від path traversal — усередині readFlight.
const payload = await readFlight(Astro.params.id);

if (payload === null) {
  return new Response('Not found', { status: 404 });
}

const title =
  payload.status === 'error' ? `Помилка — ${payload.error.flight_id}` : `Звіт — ${payload.flight.flight_id}`;
---

<Base title={title}>
  {payload.status === 'error' ? <FlightError error={payload.error} /> : <FlightSuccess flight={payload.flight} />}
</Base>
