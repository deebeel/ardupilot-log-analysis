---
// Партиал для htmx-поллінгу індексної сторінки. Повертає ТУ САМУ обгортку
// `FlightListPoller` (з hx-*), що й початковий рендер `/` — інакше після першого
// outerHTML-свапу htmx-атрибути зникнуть разом зі старим елементом і поллінг
// зупиниться на одному оновленні. `readdir` — у тілі сторінки, сканується на кожен
// запит, як і вимагає SSR-контракт результатів.
import FlightListPoller from '../../components/FlightListPoller.astro';
import { listFlights } from '../../lib/results.ts';

export const prerender = false;

const flights = await listFlights();
---

<FlightListPoller flights={flights} />
